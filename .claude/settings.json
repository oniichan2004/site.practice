{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": true,
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(tsc)",
      "Bash(tsc *)",
      "Bash(node *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Bash(git push *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
